#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Pi Agent Add-on: Environment setup
# Sets up PI_CODING_AGENT_DIR and environment variables
# ==============================================================================

bashio::log.info 'Setting up Pi Agent environment...'

# --- Persistent storage ---
PI_DIR=/data/pi-agent
mkdir -p "${PI_DIR}/sessions"

# --- Docs cache ---
mkdir -p /data/ha-docs

# --- Write s6 env vars (available to all services via with-contenv) ---
printf '%s' "${PI_DIR}" > /var/run/s6/container_environment/PI_CODING_AGENT_DIR
printf '%s' "${SUPERVISOR_TOKEN}" > /var/run/s6/container_environment/HA_TOKEN
printf '%s' "http://supervisor/core" > /var/run/s6/container_environment/HA_URL
printf '%s' "/homeassistant" > /var/run/s6/container_environment/HA_CONFIG_PATH
printf '%s' "/data/ha-docs" > /var/run/s6/container_environment/HA_DOCS_DATA_DIR

# --- Write profile.d for interactive shells (tmux/ttyd) ---
{
    echo "export PI_CODING_AGENT_DIR=\"${PI_DIR}\""
    echo "export SUPERVISOR_TOKEN=\"${SUPERVISOR_TOKEN}\""
    echo "export HA_TOKEN=\"${SUPERVISOR_TOKEN}\""
    echo "export HA_URL=\"http://supervisor/core\""
    echo "export HA_CONFIG_PATH=\"/homeassistant\""
    echo "export HA_DOCS_DATA_DIR=\"/data/ha-docs\""
} > /etc/profile.d/pi-agent.sh

# --- Default provider ---
default_provider=$(bashio::config 'default_provider')
if bashio::var.has_value "${default_provider}"; then
    printf '%s' "${default_provider}" > /var/run/s6/container_environment/PI_DEFAULT_PROVIDER
    echo "export PI_DEFAULT_PROVIDER=\"${default_provider}\"" >> /etc/profile.d/pi-agent.sh
fi

# --- Default model ---
default_model=$(bashio::config 'default_model')
if bashio::var.has_value "${default_model}"; then
    printf '%s' "${default_model}" > /var/run/s6/container_environment/PI_DEFAULT_MODEL
    echo "export PI_DEFAULT_MODEL=\"${default_model}\"" >> /etc/profile.d/pi-agent.sh
fi

# --- Service provider/model (for pi_agent.ask, separate from interactive defaults) ---
service_provider=$(bashio::config 'service_provider')
if bashio::var.has_value "${service_provider}"; then
    printf '%s' "${service_provider}" > /var/run/s6/container_environment/PI_SERVICE_PROVIDER
    echo "export PI_SERVICE_PROVIDER=\"${service_provider}\"" >> /etc/profile.d/pi-agent.sh
fi

service_model=$(bashio::config 'service_model')
if bashio::var.has_value "${service_model}"; then
    printf '%s' "${service_model}" > /var/run/s6/container_environment/PI_SERVICE_MODEL
    echo "export PI_SERVICE_MODEL=\"${service_model}\"" >> /etc/profile.d/pi-agent.sh
fi

# --- OpenAI API Base (for llama.cpp or custom OpenAI endpoint) ---
openai_api_base=$(bashio::config 'openai_api_base')
if bashio::var.has_value "${openai_api_base}"; then
    printf '%s' "${openai_api_base}" > /var/run/s6/container_environment/OPENAI_API_BASE
    printf '%s' "${openai_api_base}" > /var/run/s6/container_environment/OPENAI_BASE_URL
    echo "export OPENAI_API_BASE=\"${openai_api_base}\"" >> /etc/profile.d/pi-agent.sh
    echo "export OPENAI_BASE_URL=\"${openai_api_base}\"" >> /etc/profile.d/pi-agent.sh
    # Inject a dummy key if none exists, to satisfy the agent client schema
    if [[ ! -f /var/run/s6/container_environment/OPENAI_API_KEY ]]; then
        printf '%s' "dummy" > /var/run/s6/container_environment/OPENAI_API_KEY
        echo "export OPENAI_API_KEY=\"dummy\"" >> /etc/profile.d/pi-agent.sh
    fi
fi

# --- User-defined environment variables (API keys, provider config, etc.) ---
if bashio::config.has_value 'environment'; then
    env_count=$(bashio::config 'environment | length')
    for (( i=0; i<env_count; i++ )); do
        entry=$(bashio::config "environment[${i}]")
        key="${entry%%=*}"
        value="${entry#*=}"
        if [[ -n "${key}" ]]; then
            printf '%s' "${value}" > "/var/run/s6/container_environment/${key}"
            echo "export ${key}=\"${value}\"" >> /etc/profile.d/pi-agent.sh
            bashio::log.info "Set environment variable: ${key}"
        fi
    done
fi

# --- Custom System Prompt ("House Laws") ---
custom_system_prompt=$(bashio::config 'custom_system_prompt')
if bashio::var.has_value "${custom_system_prompt}"; then
    mkdir -p "${PI_DIR}"
    printf '%s' "${custom_system_prompt}" > "${PI_DIR}/custom_system_prompt.md"
    printf '%s' "${PI_DIR}/custom_system_prompt.md" > /var/run/s6/container_environment/CUSTOM_SYSTEM_PROMPT_FILE
    echo "export CUSTOM_SYSTEM_PROMPT_FILE=\"${PI_DIR}/custom_system_prompt.md\"" >> /etc/profile.d/pi-agent.sh
else
    rm -f "${PI_DIR}/custom_system_prompt.md"
    rm -f /var/run/s6/container_environment/CUSTOM_SYSTEM_PROMPT_FILE
    sed -i '/CUSTOM_SYSTEM_PROMPT_FILE/d' /etc/profile.d/pi-agent.sh 2>/dev/null || true
fi

# --- Symlink ~/.pi to persistent /data/pi-agent ---
mkdir -p "${PI_DIR}"
ln -sfn "${PI_DIR}" /root/.pi

# --- Export all written env vars for this process (needed by the Python block below) ---
# The s6 container_environment files only apply to NEW services started by s6-rc,
# not to the current process. We need to source the profile script to make them
# available to the inline Python script.
# shellcheck source=/dev/null
source /etc/profile.d/pi-agent.sh

# --- Generate models.json for custom/local providers ---
python3 -c '
import json, os
models_path = "/data/pi-agent/agent/models.json"
os.makedirs(os.path.dirname(models_path), exist_ok=True)
try:
    with open(models_path, "r") as f:
        data = json.load(f)
except Exception:
    data = {}
if "providers" not in data:
    data["providers"] = {}

def fetch_models(base_url, api_key):
    if not base_url or not api_key:
        return []
    import urllib.request
    try:
        url = base_url + "/models" if not base_url.endswith("/") else base_url + "models"
        req = urllib.request.Request(url, headers={"Authorization": f"Bearer {api_key}"})
        with urllib.request.urlopen(req, timeout=3) as response:
            res_data = json.loads(response.read().decode())
            if "data" in res_data:
                return [{"id": m["id"]} for m in res_data["data"] if "id" in m]
    except Exception as e:
        print(f"Failed to fetch models from {base_url}: {e}")
    return []

def get_unique(models):
    seen = set()
    unique = []
    for m in models:
        if m["id"] not in seen:
            seen.add(m["id"])
            unique.append(m)
    return unique

# Read environment keys
opencode_key = os.environ.get("OPENCODE_ZEN_API_KEY", "")
opencode_go_key = os.environ.get("OPENCODE_GO_API_KEY", "")
minimax_key = os.environ.get("MINIMAX_API_KEY", "")
omniroute_key = os.environ.get("OMNIROUTE_API_KEY", "")
openai_base = os.environ.get("OPENAI_API_BASE", "")
default_model = os.environ.get("PI_DEFAULT_MODEL", "")
service_model = os.environ.get("PI_SERVICE_MODEL", "")

models_list = []
for m in [default_model, service_model]:
    if m and m.strip():
        models_list.append({"id": m.strip()})

if opencode_key:
    discovered = fetch_models("https://opencode.ai/zen/v1", opencode_key)
    data["providers"]["opencode-zen"] = {
        "baseUrl": "https://opencode.ai/zen/v1",
        "api": "openai-completions",
        "apiKey": opencode_key,
        "models": get_unique(models_list + discovered + [{"id": "opencode-zen"}])
    }
if opencode_go_key:
    discovered = fetch_models("https://opencode.ai/zen/go/v1", opencode_go_key)
    data["providers"]["opencode-go"] = {
        "baseUrl": "https://opencode.ai/zen/go/v1",
        "api": "openai-completions",
        "apiKey": opencode_go_key,
        "models": get_unique(models_list + discovered + [{"id": "opencode-go"}])
    }
if minimax_key:
    discovered = fetch_models("https://api.minimax.io/v1", minimax_key)
    data["providers"]["minimax"] = {
        "baseUrl": "https://api.minimax.io/v1",
        "api": "openai-completions",
        "apiKey": minimax_key,
        "models": get_unique(models_list + discovered + [{"id": "MiniMax-M3"}, {"id": "MiniMax-M2.7"}, {"id": "minimax"}])
    }
if omniroute_key:
    discovered = fetch_models("https://omniroute.inuar.uk/v1", omniroute_key)
    data["providers"]["omniroute"] = {
        "baseUrl": "https://omniroute.inuar.uk/v1",
        "api": "openai-completions",
        "apiKey": omniroute_key,
        "models": get_unique(models_list + discovered + [{"id": "omniroute"}])
    }
if openai_base:
    discovered = fetch_models(openai_base, "dummy")
    data["providers"]["llama-cpp"] = {
        "baseUrl": openai_base,
        "api": "openai-completions",
        "apiKey": "dummy",
        "models": get_unique(models_list + discovered + [{"id": "llama-cpp"}])
    }
with open(models_path, "w") as f:
    json.dump(data, f, indent=2)
'

# --- Persistent bash history ---
touch /data/.bash_history
ln -sf /data/.bash_history /root/.bash_history

# --- Pi settings: disable changelog popup, quiet startup, and enable extensions ---
PI_SETTINGS="${PI_DIR}/settings.json"
if [[ ! -f "${PI_SETTINGS}" ]]; then
    echo '{}' > "${PI_SETTINGS}"
fi
tmp=$(mktemp)
jq '. + {"quietStartup": true, "collapseChangelog": true} | .packages = ((.packages // []) + ["npm:context-mode", "npm:pi-web-access"] | unique)' "${PI_SETTINGS}" > "$tmp" && mv "$tmp" "${PI_SETTINGS}"

# --- Clean up legacy extension copy from /homeassistant volume ---
if [[ -d /homeassistant/.pi/extensions/home-assistant ]]; then
    bashio::log.info 'Removing legacy extension from /homeassistant/.pi/extensions/home-assistant...'
    rm -rf /homeassistant/.pi/extensions/home-assistant
fi

# --- Convenient symlinks ---
ln -sf /homeassistant /root/homeassistant
ln -sf /share /root/share

bashio::log.info 'Pi Agent environment ready.'
